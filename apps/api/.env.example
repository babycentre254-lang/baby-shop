# ─── App ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000

# ─── Database ──────────────────────────────────────────
MONGODB_URI=mongodb://babyshop:babyshop@localhost:27017/baby-shop?authSource=admin

# ─── Redis (BullMQ later) ──────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT ───────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-in-prod-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-in-prod-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cookie ────────────────────────────────────────────
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ─── M-Pesa (fill in Batch 5) ──────────────────────────
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# ─── Brevo transactional email (SMTP) ──────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_EMAIL=support@babycentre.co.ke
MAIL_FROM_NAME=BabyCentre Baby Shop

# ─── Stripe (fill in Batch 5) ──────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
