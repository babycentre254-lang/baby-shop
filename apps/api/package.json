{
  "name": "@baby-shop/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest build && node --watch dist/main.js",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run build --workspace=@baby-shop/shared",
    "prestart:dev": "npm run build --workspace=@baby-shop/shared",
    "dev": "nest build && node --watch dist/main.js",
    "watch:ts": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "seed:admin": "ts-node -r dotenv/config src/scripts/seed-admin.ts dotenv_config_path=.env"
  },
  "dependencies": {
    "@baby-shop/shared": "*",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.10",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.2.1",
    "@types/nodemailer": "^8.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "mongoose": "^8.7.1",
    "nodemailer": "^10.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "slugify": "^1.6.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.5",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
